# ===========================================
# PennyPlan Environment Variables
# Copy this file to .env.local and fill in your values
# ===========================================

# GitHub Models API (GPT-4o for sketch parsing)
# Use your GitHub PAT (Classic) with "models:read" scope
GITHUB_TOKEN=your_github_token_here

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=pennyplan-furniture

# OpenAI (for embeddings if needed)
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_BUDGET_DEFAULT=5000
